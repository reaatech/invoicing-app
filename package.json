{
  "name": "invoicing-app",
  "private": true,
  "version": "0.0.2",
  "description": "Personal invoicing desktop app",
  "author": "Rick",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "build": "tsc -b && vite build",
    "build:electron": "npx tsc -b tsconfig.node.json && npx tsc -b tsconfig.preload.json && vite build --outDir dist/electron/app && mkdir -p dist/electron/database/migrations dist/electron/templates && cp -R electron/database/migrations/*.sql dist/electron/database/migrations/ && cp -R src/templates/* dist/electron/templates/ && electron-builder",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-better-sqlite3.js",
    "start:electron": "electron ./dist/electron/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@headlessui/react": "^2.2.9",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@mui/x-data-grid": "^9.0.4",
    "better-sqlite3": "^12.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.12.0",
    "mustache": "^4.2.0",
    "nodemailer": "^9.0.1",
    "puppeteer": "^25.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.24",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.5",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "form-data": "4.0.6",
    "undici": "7.28.0",
    "node-gyp": {
      "undici": "6.27.0"
    }
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "undici@>=6.0.0 <7.0.0": "6.27.0",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "ws": "8.21.0",
      "@babel/core": "7.29.7",
      "js-yaml": "4.2.0"
    }
  }
}

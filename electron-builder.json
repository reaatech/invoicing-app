{
  "appId": "com.rick.invoicingapp",
  "productName": "Invoicing App",
  "directories": {
    "output": "release"
  },
  "files": ["dist/electron/**/*", "dist/electron/templates/**/*", "electron/**/*", "public/**/*"],
  "extraResources": [
    {
      "from": "src/templates",
      "to": "templates"
    }
  ],
  "asar": true,
  "extraMetadata": {
    "main": "dist/electron/main.js"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "public/icon.icns"
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "public/icon.ico"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon.png"
  }
}
